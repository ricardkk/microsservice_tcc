{
  "uid": "tcc-logs",
  "title": "TCC — Visão geral dos logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "tags": [
    "tcc"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Quantidade de logs",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "tcc-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"tcc\"}[$__range]))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "Quantidade de erros",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "tcc-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"tcc\"} | json level=\"level\" | level=\"ERROR\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "Logs por serviço",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "tcc-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({job=\"tcc\"}[$__range]))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "Erros por serviço",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "tcc-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({job=\"tcc\"} | json level=\"level\" | level=\"ERROR\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "title": "Logs recentes",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "tcc-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"tcc\"}",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "showTime": true
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
