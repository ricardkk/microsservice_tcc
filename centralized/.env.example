# Copy to .env only to change defaults. Local experimental environment.
DB_PASSWORD=tcc
FAULT_ENABLED=false
FAULT_DELAY_MS=5000
DB_CONNECTION_TIMEOUT_MS=1000

# Linux Docker Engine: docker info --format '{{.DockerRootDir}}' + /containers
DOCKER_LOG_DIR=/var/lib/docker/containers
LOKI_PORT=3100
GRAFANA_PORT=3000
FLUENT_BIT_PORT=2020
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tcc-local
